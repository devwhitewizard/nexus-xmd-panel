# Server
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000
REQUEST_SIZE_LIMIT=1mb

# Supabase PostgreSQL
# Use your Supabase connection string (Direct or Pooler)
DATABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Credential Encryption (32-byte key as 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_MASTER_KEY=replace_with_64_hex_chars_32_bytes_random_key

# BWM XMD Official API
BWM_API_BASE_URL=https://pro.bwmxmd.co.ke/api/v1
BWM_API_KEY=your_private_bwm_api_key
BWM_API_TIMEOUT_MS=15000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

